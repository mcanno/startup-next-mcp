# URL base del backend startup-next (Fly.io en producción, localhost en dev)
STARTUP_NEXT_BASE_URL=https://startup-next.fly.dev

# Credencial de invocador "hermes" -- ya reservada en el backend startup-next.
# Hoy es una key compartida entre todas las instancias (ver
# Diseno_servidor_MCP_startup-next.md, "Credenciales por-startup" en
# Pendientes) -- no es un secreto por-emprendedor todavía.
API_KEY_HERMES=

# Polling sobre GET /runs/{id} mientras el run está "running".
MCP_POLL_INTERVAL_MS=3000
MCP_POLL_TIMEOUT_MS=180000
